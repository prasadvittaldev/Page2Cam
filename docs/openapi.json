{
  "openapi": "3.0.3",
  "info": {
    "title": "Page2Cam local admin API",
    "version": "0.8.0",
    "description": "The engine's control routes on http://127.0.0.1:<port>. Every request needs Host: 127.0.0.1:<port> (or localhost:<port>) and the per-launch token in X-P2C-Token (or ?t=). Bodies are JSON unless stated; at most 2 MB (pictures 20 MB, overlay files 200 MB). Errors: 4xx/5xx with {\"error\": \"…\"} or plain text."
  },
  "servers": [{ "url": "http://127.0.0.1:{port}", "variables": { "port": { "default": "8765" } } }],
  "security": [{ "token": [] }],
  "components": {
    "securitySchemes": {
      "token": { "type": "apiKey", "in": "header", "name": "X-P2C-Token" }
    },
    "schemas": {
      "Pip": {
        "type": "object",
        "required": ["visible", "x", "y", "width"],
        "properties": {
          "visible": { "type": "boolean" },
          "x": { "type": "number", "minimum": 0, "maximum": 1 },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "width": { "type": "number", "minimum": 0.05, "maximum": 0.5 },
          "style": { "type": "string", "enum": ["box", "cutout-small", "cutout-full"] }
        }
      },
      "Audio": {
        "type": "object",
        "required": ["page_on", "page_gain", "mic_on", "mic_gain"],
        "properties": {
          "page_on": { "type": "boolean" }, "page_gain": { "type": "number" },
          "mic_on": { "type": "boolean" }, "mic_gain": { "type": "number" }
        }
      },
      "Crop": {
        "type": "object",
        "required": ["x", "y", "w", "h"],
        "properties": {
          "x": { "type": "number" }, "y": { "type": "number" },
          "w": { "type": "number" }, "h": { "type": "number" },
          "save": { "type": "boolean", "description": "POST only: also write it to the settings file" }
        }
      },
      "Background": {
        "type": "object",
        "required": ["full", "in_box"],
        "properties": {
          "full": { "type": "string", "enum": ["page", "image", "colour", "youtube", "screen", "blurred-room"] },
          "full_colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "full_youtube": { "type": "string", "description": "A YouTube link or video id" },
          "full_screen": { "type": "string", "description": "For screen: a monitor id from /api/screens (e.g. DISPLAY1), a 1-based index, or empty/\"primary\" for the main monitor. Everything on that monitor is shown." },
          "in_box": { "type": "string", "enum": ["room", "blur", "image", "colour"] },
          "box_colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "refined_edges": { "type": "boolean" },
          "full_image": { "type": "boolean", "readOnly": true },
          "box_image": { "type": "boolean", "readOnly": true }
        }
      },
      "Layer": {
        "type": "object",
        "description": "One overlay layer, drawn over everything. Flat: the common fields plus those of its kind. Geometry is 0..1 of the output (x, y = top-left corner). In POST bodies every field except kind (when adding) is optional; image and video take path (a local file, copied once) or data_base64 (pictures); youtube takes link.",
        "properties": {
          "id": { "type": "string", "maxLength": 40, "description": "a-z0-9- (a given id is sanitised; else made from name or kind, e.g. title-1)" },
          "kind": { "type": "string", "enum": ["title", "ticker", "html", "template", "image", "video", "youtube"] }, "template": { "type": "string", "description": "template: an id from GET /api/templates" }, "params": { "type": "object", "description": "template: its parameter values (partial on change; null resets one)" },
          "name": { "type": "string", "maxLength": 80 },
          "x": { "type": "number", "minimum": 0, "maximum": 1 }, "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "w": { "type": "number", "minimum": 0.01, "maximum": 1 }, "h": { "type": "number", "minimum": 0.01, "maximum": 1 },
          "z": { "type": "integer", "minimum": -1000, "maximum": 1000, "description": "Stacking order, higher in front" },
          "visible": { "type": "boolean" }, "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "enter": { "type": "string", "enum": ["none", "fade", "slide-left", "slide-right", "slide-up", "slide-down"] },
          "exit": { "type": "string", "enum": ["none", "fade", "slide-left", "slide-right", "slide-up", "slide-down"] },
          "hide_after_s": { "type": "integer", "minimum": 1, "maximum": 3600, "nullable": true },
          "text": { "type": "string", "maxLength": 500, "description": "title" }, "subtitle": { "type": "string", "maxLength": 500, "description": "title" },
          "style": { "type": "string", "enum": ["news", "minimal", "brand"], "description": "title, ticker" },
          "colour": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "nullable": true }, "background": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$", "nullable": true },
          "items": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 }, "description": "ticker" },
          "speed": { "type": "integer", "minimum": 10, "maximum": 1000, "description": "ticker: px/s at 1920 wide" },
          "html": { "type": "string", "maxLength": 262144, "description": "html: a fragment run in a sandboxed frame" },
          "asset": { "type": "string", "readOnly": true, "description": "image, video: the stored copy" },
          "url": { "type": "string", "description": "video: an http(s) address" },
          "video": { "type": "string", "readOnly": true, "description": "youtube: the video id (give link)" },
          "link": { "type": "string", "writeOnly": true }, "path": { "type": "string", "writeOnly": true }, "data_base64": { "type": "string", "writeOnly": true },
          "start_s": { "type": "integer", "minimum": 0 }, "loop": { "type": "boolean" }, "muted": { "type": "boolean" }
        }
      },
      "Input": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": { "type": "string", "enum": ["click", "move", "scroll", "key", "text"] },
          "x": { "type": "number", "minimum": 0, "maximum": 1, "description": "0..1 of the output" },
          "y": { "type": "number", "minimum": 0, "maximum": 1 },
          "dx": { "type": "number" }, "dy": { "type": "number" },
          "key": { "type": "string" }, "text": { "type": "string", "maxLength": 10000 }
        }
      }
    }
  },
  "paths": {
    "/api/state": { "get": { "summary": "Status (never the stream key), overlay, audio, crop", "responses": { "200": { "description": "{status, pip, audio, crop}" } } } },
    "/api/navigate": { "post": { "summary": "Show a page", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" } } } } } }, "responses": { "200": { "description": "{url} as normalised" }, "400": { "description": "Refused scheme or bad URL" } } } },
    "/api/nav": { "post": { "summary": "Back / forward / reload", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["action"], "properties": { "action": { "type": "string", "enum": ["back", "forward", "reload"] } } } } } }, "responses": { "200": { "description": "Done" } } } },
    "/api/input": { "post": { "summary": "Click, scroll, key or text in the page (output coordinates)", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Input" } } } }, "responses": { "200": { "description": "{ok: true}" }, "400": { "description": "Out of range or unknown key" } } } },
    "/api/snapshot": { "get": { "summary": "The current output as a 1280x720 JPEG", "responses": { "200": { "description": "image/jpeg" }, "503": { "description": "No frame yet" } } } },
    "/api/pip": { "post": { "summary": "Webcam overlay layout and style", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Pip" } } } }, "responses": { "200": { "description": "Done" }, "400": { "description": "Unknown style" } } } },
    "/api/cutout": { "post": { "summary": "Cut-out model", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["engine"], "properties": { "engine": { "type": "string", "enum": ["quality", "fast"] } } } } } }, "responses": { "200": { "description": "Done" } } } },
    "/api/crop": {
      "get": { "summary": "Webcam crop", "responses": { "200": { "description": "Crop" } } },
      "post": { "summary": "Set the webcam crop (clamped)", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Crop" } } } }, "responses": { "200": { "description": "The crop as applied" } } }
    },
    "/api/audio": { "post": { "summary": "Stream sound", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Audio" } } } }, "responses": { "200": { "description": "Done" } } } },
    "/api/stream/start": { "post": { "summary": "Start the RTMP stream (empty key = the saved key)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["url"], "properties": { "url": { "type": "string" }, "key": { "type": "string" }, "remember": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "Starting" } } } },
    "/api/stream/stop": { "post": { "summary": "Stop the stream", "responses": { "200": { "description": "Done" } } } },
    "/api/gpus": { "get": { "summary": "Video processing choices", "responses": { "200": { "description": "[{name, kind}]" } } } },
    "/api/screens": { "get": { "summary": "Monitors the screen background can show (Windows)", "responses": { "200": { "description": "[{id, index, name, width, height, primary}]" }, "501": { "description": "{error}: screen capture is not available on this platform" } } } },
    "/api/gpu": { "post": { "summary": "Save the GPU choice (applies after a restart)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["choice"], "properties": { "choice": { "type": "string" } } } } } }, "responses": { "200": { "description": "Saved" } } } },
    "/api/restart": { "post": { "summary": "Restart Page2Cam", "responses": { "200": { "description": "Restarting" } } } },
    "/api/quit": { "post": { "summary": "Stop Page2Cam", "responses": { "200": { "description": "Stopping" } } } },
    "/api/update/install": { "post": { "summary": "Install the update on offer", "responses": { "200": { "description": "Installing" } } } },
    "/api/background": {
      "get": { "summary": "Background choices", "responses": { "200": { "description": "Background" } } },
      "post": { "summary": "Apply and save background choices", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Background" } } } }, "responses": { "200": { "description": "The choices as applied" }, "400": { "description": "Bad colour or link, or no picture uploaded" } } }
    },
    "/api/background/image": {
      "get": { "summary": "The stored picture", "parameters": [{ "name": "row", "in": "query", "required": true, "schema": { "type": "string", "enum": ["full", "box"] } }], "responses": { "200": { "description": "image/png or image/jpeg" }, "404": { "description": "None" } } },
      "post": { "summary": "Upload a picture (raw body, PNG/JPEG/WebP, at most 20 MB) and show it", "parameters": [{ "name": "row", "in": "query", "required": true, "schema": { "type": "string", "enum": ["full", "box"] } }], "requestBody": { "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "responses": { "200": { "description": "Background" }, "413": { "description": "Larger than 20 MB" }, "415": { "description": "Not PNG, JPEG or WebP" } } }
    },
    "/api/background/thumb": { "get": { "summary": "YouTube thumbnail (fetched by Page2Cam)", "parameters": [{ "name": "link", "in": "query", "schema": { "type": "string" } }], "responses": { "200": { "description": "image/jpeg" } } } },
    "/api/agents": {
      "get": { "summary": "Agents panel data (from the tray)", "responses": { "200": { "description": "{allowed, url, registered, activity, snippets}" }, "503": { "description": "No tray (standalone)" } } },
      "post": { "summary": "Switch agents on/off or reset their token", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "allowed": { "type": "boolean" }, "reset_token": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "As GET" } } }
    },
    "/api/layers": {
      "get": { "summary": "Overlay layers, back to front, and the choices", "responses": { "200": { "description": "{layers: [Layer], kinds, presets, anims}" } } },
      "post": { "summary": "Add an overlay layer (shown at once unless visible is false)", "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Layer" } } } }, "responses": { "200": { "description": "The new Layer, with its id" }, "400": { "description": "{error}: why (nothing changed)" } } }
    },
    "/api/layers/{id}": {
      "post": { "summary": "Change some fields of a layer (partial; visible: true shows it and restarts its auto-hide; null clears hide_after_s, colour, background)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Layer" } } } }, "responses": { "200": { "description": "The Layer as changed" }, "400": { "description": "{error}: why (nothing changed)" } } },
      "delete": { "summary": "Delete a layer and its stored file", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "{removed}" }, "400": { "description": "{error}: no such layer" } } }
    },
    "/api/layers/{id}/asset": { "post": { "summary": "Upload a new picture (PNG/JPEG/WebP/GIF) or video (MP4/WebM) for an image or video layer (raw body, at most 200 MB)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/octet-stream": { "schema": { "type": "string", "format": "binary" } } } }, "responses": { "200": { "description": "The Layer" }, "400": { "description": "{error}" }, "413": { "description": "Larger than 200 MB" }, "415": { "description": "Not a supported picture or video" } } } },
    "/api/layers/clear": { "post": { "summary": "Hide every overlay layer", "responses": { "200": { "description": "{hidden: n}" } } } },
    "/api/layers/order": { "post": { "summary": "Restack layers: ids back to front (unlisted ones stay behind)", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["ids"], "properties": { "ids": { "type": "array", "items": { "type": "string" } } } } } } }, "responses": { "200": { "description": "{layers}" }, "400": { "description": "{error}: unknown or repeated id" } } } },
    "/api/templates": {
      "get": { "summary": "Overlay templates (built-in and the user's own)", "parameters": [{ "name": "category", "in": "query", "schema": { "type": "string", "enum": ["basics", "time", "cards", "lists", "data", "cta", "calm", "software", "mine"] } }], "responses": { "200": { "description": "{templates: [{id, name, category, description, builtin, full_frame}], categories: [{id, label}]}" } } },
      "post": { "summary": "Save a user template: a full definition {id, name, category, description, params, html, rect, example, update, full_frame}, or {from_layer, name} (an html layer), or {copy_of, id, …changes}. The same id replaces it; built-in ids are refused; at most 200", "requestBody": { "content": { "application/json": { "schema": { "type": "object" } } } }, "responses": { "200": { "description": "The template in full" }, "400": { "description": "{error}" } } }
    },
    "/api/templates/{id}": {
      "get": { "summary": "One template in full: params (with all_params incl. theme and accent), example, update example, html", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "The template" }, "404": { "description": "{error}" } } },
      "delete": { "summary": "Delete a user template (layers using it show \"template missing\")", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "{removed}" }, "400": { "description": "{error}: built-in or unknown" } } }
    },
    "/api/scenes": {
      "get": { "summary": "Saved looks (scenes)", "responses": { "200": { "description": "{scenes: [{id, name, layers, visible_layers, has_background, has_webcam, created}]}" } } },
      "post": { "summary": "Save the current layers (and optionally background and webcam overlay) as a scene; the same name replaces it; at most 100", "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["name"], "properties": { "name": { "type": "string" }, "include_background": { "type": "boolean" }, "include_webcam": { "type": "boolean" } } } } } }, "responses": { "200": { "description": "The scene summary" }, "400": { "description": "{error}" } } }
    },
    "/api/scenes/{id}/load": { "post": { "summary": "Load a scene: replace (default; other layers removed first) or add (in front)", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "properties": { "mode": { "type": "string", "enum": ["replace", "add"] } } } } } }, "responses": { "200": { "description": "{scene, added, skipped, notes, background_full}" }, "400": { "description": "{error}" } } } },
    "/api/scenes/{id}": { "delete": { "summary": "Delete a scene and its copied files", "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }], "responses": { "200": { "description": "{removed}" }, "400": { "description": "{error}" } } } }
  }
}
